# PAAW Environment Configuration
# Copy this to .env and adjust for your instance
#
# Main instance (tPAAW):  use ports 4097/4098/4100/5173
# Dev instance (tPAAW-dev): use ports 4200/4201/4202/5200
# Production instance: npm run start:prod → .env.prod → 4399/4400/4402
# （PAAW_ENV=prod 時 shared.mjs 優先載入 .env.prod；UI same-origin 不烙 port）

# ── API Server ──
PAAW_PORT=4097

# ── WebSocket (Terminal/PTY) ──
PAAW_WS_PORT=4098

# ── Agent Orchestrator Bridge ──
BRIDGE_PORT=4100

# ── Vite Dev Server (UI only, proxies API to PAAW_PORT) ──
VITE_PORT=5173
