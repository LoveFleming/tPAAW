# PAAW Environment Configuration
# Copy this to .env and adjust for your instance
#
# Main instance (tPAAW):  use ports 4097/4098/4100/5173
# Dev instance (tPAAW-dev): use ports 4200/4201/4202/5200
# Production instance: npm run start:prod → .env.prod → 4399/4400/4402
# （PAAW_ENV=prod 時 shared.mjs 優先載入 .env.prod；UI same-origin 不烙 port）

# ── API Server ──
PAAW_PORT=4097

# ── WebSocket (Terminal/PTY) ──
PAAW_WS_PORT=4098

# ── Agent Orchestrator Bridge ──
BRIDGE_PORT=4100

# ── Vite Dev Server (UI only, proxies API to PAAW_PORT) ──
VITE_PORT=5173

# ── Elasticsearch LLM Log Shipping（2026-10-04；2026-10-12 加帳密 + index 前綴）──
# 設了才開：agent 執行 log（LLM 呼叫/tokens/成本）即時送 ES，供 Kibana「PAAW Agent 執行報表」
# 沒設 = 功能關閉（零开销）。doc/_id 與外部 ship-agent-logs.mjs 冪等相容
# index 命名 = <前綴> + yyyymm（月滾動，例：paaw-agent-logs-202610；前綴未帶分隔符會自動補「-」）
# PAAW_ES_URL=http://127.0.0.1:9200
# PAAW_ES_USERNAME=elastic              # Basic Auth 帳號（留空＝不帶認證）
# PAAW_ES_PASSWORD=changeme             # Basic Auth 密碼（也可寫在 URL：http://user:pass@host）
# PAAW_ES_INDEX_PREFIX=paaw-agent-logs  # 換一組前綴＝送到不同 index（多機器/多環境分流）
# PAAW_ES_AUDIT_PREFIX=paaw-audit       # 審計事件 index 前綴
