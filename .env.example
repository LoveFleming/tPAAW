# PAAW Environment Configuration
# Copy this to .env for production, or .env.dev for development
#
# When running a SECOND PAAW instance (e.g. inside Coding App terminal),
# use different ports to avoid conflict with the main PAAW:
#   npm run dev:alt
#
# This uses .env.dev with ports 4200/4201/4202/5200

# ── API Server ──
PAAW_PORT=4097

# ── WebSocket (Terminal/PTY) ──
PAAW_WS_PORT=4098

# ── Agent Orchestrator Bridge ──
BRIDGE_PORT=4100

# ── Vite Dev Server (UI only, proxies API to PAAW_PORT) ──
VITE_PORT=5173
