{
  "version": 1,
  "dispatchStrategy": "balanced",
  "autoExecute": {
    "tests": true,
    "docs": true,
    "refactor": false,
    "securityFix": false,
    "breakingChange": false
  },
  "taskDecomposition": {
    "maxSubtasks": 100,
    "defaultEffort": "S",
    "requireEstimate": true
  },
  "reporting": {
    "format": "summary",
    "includeCodeChanges": true,
    "includeActionLog": true
  },
  "model": {
    "planning": "zai/glm-5.1",
    "dispatch": "zai/glm-5.1"
  },
  "closedLoop": {
    "enabled": true,
    "maxRounds": 30
  },
  "dispatchableAgents": [],
  "blockedAgents": [],
  "reviewConfig": {
    "multiAgentReview": false,
    "reviewModels": [],
    "autoRework": true
  },
  "planningScope": {
    "gitChanges": true,
    "openIssues": true,
    "openTasks": true,
    "securityFindings": true,
    "testCoverage": true,
    "codeIntelligence": false
  }
}