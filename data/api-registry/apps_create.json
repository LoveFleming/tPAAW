{
  "route": "POST /api/apps",
  "routeId": "apps_create",
  "name": "AppsCreate",
  "category": "apps",
  "description": "建立新 App。支援 Data App 和 Skill-based App。自動產生 app.json + data 檔案。",
  "source": "paaw-server.mjs",
  "parameters": {
    "body": {
      "id": { "type": "string", "required": true, "description": "App ID（小寫英文、數字、底線，需以字母開頭）" },
      "name": { "type": "string", "required": false, "description": "App 顯示名稱" },
      "icon": { "type": "string", "required": false, "description": "App 圖示（emoji）" },
      "description": { "type": "string", "required": false, "description": "App 描述" },
      "type": { "type": "string", "required": false, "description": "data 或 skill-based" },
      "dataShape": { "type": "string", "required": false, "description": "array 或 object" },
      "schema": { "type": "object", "required": false, "description": "JSON Schema" },
      "execSchema": { "type": "object", "required": false, "description": "執行參數 Schema（skill-based 用）" },
      "triggers": { "type": "array", "required": false, "description": "觸發關鍵字列表" },
      "aiPrompt": { "type": "string", "required": false, "description": "AI 提示詞" }
    }
  },
  "response": {
    "type": "object",
    "description": "{ ok: true, app: { ... } }"
  },
  "enabled": true,
  "autoTool": true
}