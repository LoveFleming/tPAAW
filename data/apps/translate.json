{
  "id": "translate",
  "name": "翻譯器",
  "icon": "🌐",
  "description": "多國語言翻譯器，預設中翻英，特殊詞彙自動包裝成經典例句或笑話",
  "status": "published",
  "dataShape": "array",
  "type": "skill-based",
  "triggers": [
    "幫我翻譯",
    "help me translate",
    "translate",
    "翻譯"
  ],
  "schema": {
    "items": {
      "properties": {
        "source_text": {
          "type": "string",
          "required": true
        },
        "source_lang": {
          "type": "string",
          "required": false,
          "default": "zh-TW"
        },
        "target_lang": {
          "type": "string",
          "required": false,
          "default": "en"
        },
        "translated_text": {
          "type": "string",
          "required": true
        },
        "highlights": {
          "type": "string",
          "required": false
        }
      }
    }
  },
  "aiPrompt": "翻譯工具。使用者說「幫我翻譯」「translate」時呼叫。會用 Skill + CLI 執行，回傳翻譯結果 + 特殊詞彙例句/笑話。"
}