{
  "id": "claude",
  "name": "Claude Code",
  "description": "Anthropic Claude Code CLI",
  "bins": {
    "darwin": "claude",
    "linux": "claude",
    "win32": "claude.cmd"
  },
  "shell": { "win32": true },
  "modes": {
    "interactive": {
      "args": [],
      "description": "TUI interactive mode"
    },
    "noninteractive": {
      "args": [
        "--dangerously-skip-permissions",
        "--max-turns", "{maxTurns}"
      ],
      "promptVia": "arg",
      "supportsStreaming": true
    }
  },
  "capabilities": {
    "approvalModes": ["default", "yolo"],
    "maxTurns": { "param": "--max-turns", "type": "number", "default": 50, "min": 1 },
    "maxWallTime": false,
    "outputFormats": ["text", "json"],
    "modelSelection": true
  }
}
