        "127\\.0\\.0\\.1:\\d+",
        "Redis\\.new",
        "ActiveRecord"
      ]
    }
  },
  "rules": {
    "order": [
      "needs-key",
      "needs-service",
      "needs-network",
      "hermetic"
    ],
    "note": "依序判定：有 key 讀取→needs-key；有服務啟動/基礎設施→needs-service；有外部 HTTP 且無 mock→needs-network；其餘（有 mock 或全無外界訊號）→hermetic"
  }
}