{
  "version": 1,
  "note": "測試自足性（hermeticity）判定表 —— 語言無關 3 層。加語言 = 加 row，不改程式。",
  "labels": {
    "hermetic": "自足：mock 或純函式，不碰外界，clone 下來就能跑，結果可重現",
    "needs-key": "要金鑰：會呼叫真外部廠商 API，需提供 API key（否則 401/403）",
    "needs-network": "要連網：需要外網（不一定需 key），離線即失敗",
    "needs-service": "要服務：需要本機服務/基礎設施（DB、Redis、本機 server、容器）"
  },
  "sharedLexicon": {
    "key": [
      "API_?KEY",
      "APIKEY",
      "APP_?KEY",
      "SECRET",
      "_TOKEN",
      "TOKEN_",
      "ACCESS_?KEY",
      "PRIVATE_?KEY",
      "CREDENTIAL",
      "_PASSWORD",
      "PASSWORD_",
      "BEARER"
    ],
    "service": [
      "REDIS_URL",
      "REDIS_HOST",
      "DATABASE_URL",
      "DB_URL",
      "POSTGRES",
      "MYSQL",
      "MONGO",
      "KAFKA",
      "ELASTICSEARCH",
      "MINIO",
      "S3_ENDPOINT"
    ]
  },
