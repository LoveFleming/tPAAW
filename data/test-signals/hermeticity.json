        "setupServer\\(",
        "msw/node"
      ],
      "http": [
        "fetch\\(",
        "axios",
        "got\\(",
        "http\\.request",
        "https\\.request",
        "undici",
        "node-fetch",
        "superagent"
      ],
      "envRead": [
        "process\\.env\\."
      ],
      "serviceStart": [
        "localhost:\\d+",
        "127\\.0\\.0\\.1:\\d+",
        "createServer\\(",
        "supertest\\(",
        "listen\\("
      ]
    },
    "py": {
      "mock": [
        "unittest\\.mock",
        "from unittest import mock",
