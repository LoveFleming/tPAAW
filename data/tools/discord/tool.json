{
  "name": "discord_send",
  "description": "發送 Discord 訊息到指定頻道",
  "parameters": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "description": "頻道 ID"
      },
      "message": {
        "type": "string",
        "description": "訊息內容"
      }
    },
    "required": [
      "channel",
      "message"
    ]
  },
  "runner": "api",
  "api": {
    "method": "POST",
    "url": "https://discord.com/api/v10/channels/{{channel}}/messages",
    "headers": {
      "Authorization": "Bot {{…token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "content": "{{message}}"
    }
  },
  "enabled": true,
  "updatedAt": "2026-07-23T13:10:50.849Z"
}