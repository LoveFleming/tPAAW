{
  "id": "techcrunch-digest",
  "name": "TechCrunch 每日摘要",
  "description": "Tool 抓 TechCrunch RSS → Skill 分析摘要 → 輸出",
  "icon": "📰",
  "status": "published",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "position": {"x": 50, "y": 150},
      "config": {"inputMapping": {}}
    },
    {
      "id": "node-1",
      "type": "tool",
      "toolName": "techcrunch_fetch",
      "name": "抓 TechCrunch 新聞",
      "position": {"x": 300, "y": 150},
      "config": {
        "inputMapping": {
          "limit": 10
        }
      }
    },
    {
      "id": "node-2",
      "type": "skill",
      "skillId": "news-summarizer",
      "name": "AI 摘要分析",
      "position": {"x": 600, "y": 150},
      "config": {
        "inputMapping": {
          "news_data": "{{node-1.output}}",
          "source_name": "TechCrunch"
        }
      }
    },
    {
      "id": "end",
      "type": "end",
      "name": "輸出",
      "position": {"x": 900, "y": 150},
      "config": {"outputTarget": "chat"}
    }
  ],
  "edges": [
    {"source": "start", "target": "node-1"},
    {"source": "node-1", "target": "node-2"},
    {"source": "node-2", "target": "end"}
  ]
}
