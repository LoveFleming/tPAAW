{
  "id": "text-analyzer",
  "name": "文字分析器",
  "description": "提取重點 → 產生摘要報告",
  "icon": "📊",
  "status": "published",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "position": {
        "x": 50,
        "y": 120
      },
      "config": {
        "inputMapping": {}
      }
    },
    {
      "id": "node-1",
      "type": "skill",
      "skillId": "translate",
      "appName": "translate",
      "name": "翻譯",
      "position": {
        "x": 48,
        "y": 64
      },
      "config": {
        "inputMapping": {
          "source_text": "{{workflow.input.text}}",
          "target_lang": "en"
        }
      }
    },
    {
      "id": "node-2",
      "type": "skill",
      "skillId": "idiom-packaging",
      "appName": "translate",
      "name": "重點包裝",
      "position": {
        "x": 432,
        "y": 144
      },
      "config": {
        "inputMapping": {
          "word": "{{workflow.input.text}}",
          "word_type": "jargon",
          "context": "{{node-1.output.translation}}"
        }
      }
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "position": {
        "x": 682,
        "y": 120
      },
      "config": {
        "inputMapping": {},
        "outputTarget": "chat"
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-node-1",
      "source": "start",
      "target": "node-1"
    },
    {
      "id": "e1-2",
      "source": "node-1",
      "target": "node-2"
    },
    {
      "id": "e-node-2-end",
      "source": "node-2",
      "target": "end"
    }
  ],
  "inputSchema": {
    "properties": {
      "text": {
        "type": "string",
        "description": "要分析的文字"
      }
    },
    "required": [
      "text"
    ]
  }
}