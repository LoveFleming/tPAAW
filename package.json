{
  "name": "paaw",
  "private": true,
  "version": "0.1.0",
  "description": "PAAW — Personal AI Assistant Workspace. Build your personal AI Workforce.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"UI,API\" -c \"cyan,magenta\" \"npm run dev -w @paaw/ui\" \"npm run dev -w @paaw/server\"",
    "dev:ui": "npm run dev -w @paaw/ui",
    "dev:server": "npm run dev -w @paaw/server",
    "dev:bridge": "node packages/server/src/lib/bridge/paaw-bridge.mjs",
    "build": "npm run build -w @paaw/ui",
    "migrate": "npm run migrate -w @paaw/db",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} \\;"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4"
  }
}
