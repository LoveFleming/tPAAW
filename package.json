{
  "name": "tagent",
  "private": true,
  "version": "0.1.0",
  "description": "知識工作者將工作轉化為 AI Agent 能力，並持續累積與重用的平台",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"UI,API\" -c \"cyan,magenta\" \"npm run dev -w @tagent/ui\" \"npm run dev -w @tagent/server\"",
    "dev:ui": "npm run dev -w @tagent/ui",
    "dev:server": "npm run dev -w @tagent/server",
    "build": "npm run build -w @tagent/ui",
    "migrate": "npm run migrate -w @tagent/db",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} \\;"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4"
  }
}
