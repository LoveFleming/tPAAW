{
  "name": "paaw",
  "private": true,
  "version": "0.1.0",
  "description": "PAAW — Personal AI Assistant Workspace. Build your personal AI Workforce.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"UI,API\" -c \"cyan,magenta\" \"npm run dev -w @paaw/ui\" \"npm run dev -w @paaw/server\"",
    "dev:ui": "npm run dev -w @paaw/ui",
    "dev:server": "npm run dev -w @paaw/server",
    "dev:bridge": "node packages/server/src/lib/bridge/paaw-bridge.mjs",
    "build": "npm run build -w @paaw/ui",
    "migrate": "npm run migrate -w @paaw/db",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} \\;",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "check:imports": "node packages/server/src/lib/import-check.mjs --strict",
    "dev:alt": "concurrently -k -n \"UI,API\" -c \"cyan,magenta\" \"npm run dev:alt:ui -w @paaw/ui\" \"npm run dev:alt:server -w @paaw/server\"",
    "dev:alt:ui": "vite --mode dev",
    "dev:alt:server": "node scripts/dev-server.mjs",
    "sync": "node scripts/paaw-sync.mjs",
    "sync:status": "node scripts/paaw-sync.mjs status"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
