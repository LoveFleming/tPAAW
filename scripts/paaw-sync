#!/bin/bash
# ──────────────────────────────────────────────────────────
# paaw-sync: Fast overwrite tPAAW → tPAAW-dev (or reverse)
#
# Usage:
#   paaw-sync          # tPAAW → tPAAW-dev (stable → dev)
#   paaw-sync dev      # tPAAW-dev → tPAAW (dev → stable)
#   paaw-sync status   # Show diff count between the two
#
# The cycle:
#   1. Develop in tPAAW-dev (Coding App terminal: npm run dev:alt)
#   2. Verify → commit+push from tPAAW-dev
#   3. paaw-sync dev    # push changes back to tPAAW
#   4. Use tPAAW for other projects
#   5. paaw-sync        # sync any tPAAW changes back to dev
#   6. Repeat
# ──────────────────────────────────────────────────────────

set -euo pipefail

TPAAW="/Users/steward/App/tPAAW"
TPAAW_DEV="/Users/steward/App/tPAAW-dev"

# Color helpers
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[sync]${NC} $1"; }
ok()    { echo -e "${GREEN}[sync]${NC} $1"; }
warn()  { echo -e "${YELLOW}[sync]${NC} $1"; }

# ── Status mode ──
if [ "${1:-}" = "status" ]; then
  echo ""
  echo -e "${CYAN}═══ PAAW Sync Status ═══${NC}"
  echo ""

  # Git log diff
  TPAAW_COMMIT=$(cd "$TPAAW" && git log --oneline -1)
  TPAAW_DEV_COMMIT=$(cd "$TPAAW_DEV" && git log --oneline -1)
  echo "  tPAAW:     $TPAAW_COMMIT"
  echo "  tPAAW-dev: $TPAAW_DEV_COMMIT"

  # Count commits ahead/behind
  COMMON=$(cd "$TPAAW_DEV" && git merge-base HEAD "$TPAAW/dev" 2>/dev/null || echo "none")
  if [ "$COMMON" != "none" ]; then
    AHEAD=$(cd "$TPAAW_DEV" && git rev-list --count "$COMMON..HEAD" 2>/dev/null || echo "?")
    BEHIND=$(cd "$TPAAW_DEV" && git rev-list --count "HEAD..$TPAAW/dev" 2>/dev/null || echo "?")
    echo "  tPAAW-dev: $AHEAD commits ahead, $BEHIND commits behind tPAAW/dev"
  fi

  # Uncommitted changes
  TPAAW_DIRTY=$(cd "$TPAAW" && git status --short | wc -l | tr -d ' ')
  TPAAW_DEV_DIRTY=$(cd "$TPAAW_DEV" && git status --short | wc -l | tr -d ' ')
  echo ""
  echo "  tPAAW:     ${TPAAW_DIRTY} uncommitted files"
  echo "  tPAAW-dev: ${TPAAW_DEV_DIRTY} uncommitted files"
  echo ""
  exit 0
fi

# ── Direction ──
if [ "${1:-}" = "dev" ]; then
  SRC="$TPAAW_DEV"
  DST="$TPAAW"
  DIRECTION="tPAAW-dev → tPAAW"
else
  SRC="$TPAAW"
  DST="$TPAAW_DEV"
  DIRECTION="tPAAW → tPAAW-dev"
fi

echo ""
echo -e "${CYAN}═══ PAAW Sync: ${DIRECTION} ═══${NC}"
echo ""

# ── Step 1: Auto-commit uncommitted changes in source ──
SRC_DIRTY=$(cd "$SRC" && git status --short | wc -l | tr -d ' ')
if [ "$SRC_DIRTY" -gt 0 ]; then
  warn "Source has $SRC_DIRTY uncommitted files — auto-committing..."
  cd "$SRC"
  git add -A
  git commit -m "auto: pre-sync snapshot $(date +%Y-%m-%d-%H%M)" --allow-empty-message 2>/dev/null || true
  ok "Source committed."
fi

# ── Step 2: Push from source ──
info "Pushing from source..."
cd "$SRC"
git push origin dev 2>/dev/null || {
  warn "Push failed (maybe no upstream). Trying force-with-lease..."
  git push --force-with-lease origin dev 2>/dev/null || true
}

# ── Step 3: Pull in destination ──
info "Pulling in destination..."
cd "$DST"
# Stash any uncommitted work first
DST_DIRTY=$(git status --short | wc -l | tr -d ' ')
if [ "$DST_DIRTY" -gt 0 ]; then
  warn "Destination has $DST_DIRTY uncommitted files — stashing..."
  git stash --include-untracked -q 2>/dev/null || true
fi

git fetch origin dev 2>/dev/null || true
git reset --hard origin/dev 2>/dev/null || git pull --force origin dev 2>/dev/null || true

# Pop stash if we stashed
if [ "$DST_DIRTY" -gt 0 ]; then
  git stash pop -q 2>/dev/null || warn "Stash pop had conflicts (check manually)"
fi

# ── Step 4: npm install if needed ──
if [ -f "$DST/package.json" ]; then
  DST_HASH=$(cd "$DST" && cat package.json packages/server/package.json packages/ui/package.json 2>/dev/null | md5 | cut -d' ' -f1)
  SRC_HASH=$(cd "$SRC" && cat package.json packages/server/package.json packages/ui/package.json 2>/dev/null | md5 | cut -d' ' -f1)
  if [ "$DST_HASH" != "$SRC_HASH" ]; then
    info "package.json changed — running npm install..."
    cd "$DST" && npm install --silent 2>/dev/null &
  fi
fi

# ── Done ──
echo ""
ok "✅ Sync complete: ${DIRECTION}"
echo ""

# Show result
DST_COMMIT=$(cd "$DST" && git log --oneline -1)
DST_DIRTY_AFTER=$(cd "$DST" && git status --short | wc -l | tr -d ' ')
echo "  Destination: $DST_COMMIT (${DST_DIRTY_AFTER} uncommitted files)"
echo ""
