#!/bin/bash
# ──────────────────────────────────────────────────────────
# paaw-sync: Fast overwrite tPAAW ↔ tPAAW-dev
#
# Usage:
#   paaw-sync              # tPAAW → tPAAW-dev (stable → dev) via rsync
#   paaw-sync dev          # tPAAW-dev → tPAAW (dev → stable) via rsync
#   paaw-sync git          # tPAAW → tPAAW-dev via git push/pull (needs GitHub)
#   paaw-sync git dev      # tPAAW-dev → tPAAW via git push/pull (needs GitHub)
#   paaw-sync status       # Show diff between the two
#
# Two sync modes:
#   1. rsync (default) — 直接複製檔案，不需要 GitHub
#      適合：source code 還在公司開發機，沒進 GitHub
#   2. git             — 透過 GitHub push/pull 同步
#      適合：已經有 GitHub repo，兩台機器之間 sync
#
# The dogfooding cycle:
#   1. Develop in tPAAW-dev (Coding App terminal: npm run dev:alt)
#   2. Verify → paaw-sync dev (推回 tPAAW)
#   3. Use tPAAW for other projects
#   4. paaw-sync (sync tPAAW changes back to dev)
#   5. Repeat
# ──────────────────────────────────────────────────────────

set -euo pipefail

TPAAW="/Users/steward/App/tPAAW"
TPAAW_DEV="/Users/steward/App/tPAAW-dev"

# Windows paths (for company dev machine)
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
  TPAAW="C:/App/tPAAW"
  TPAAW_DEV="C:/App/tPAAW-dev"
fi

# Color helpers
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[sync]${NC} $1"; }
ok()    { echo -e "${GREEN}[sync]${NC} $1"; }
warn()  { echo -e "${YELLOW}[sync]${NC} $1"; }

# ── Parse args ──
MODE="rsync"      # rsync or git
DIRECTION="main"  # main (→dev) or dev (→main)

for arg in "$@"; do
  case "$arg" in
    git)    MODE="git" ;;
    dev)    DIRECTION="dev" ;;
    status) ;;
    *) echo "Unknown arg: $arg"; exit 1 ;;
  esac
done

# ── Shared excludes (source code only, no runtime state) ──
SYNC_EXCLUDES=(
  --exclude='.git'
  --exclude='node_modules'
  --exclude='.env'             # 各自的 .env，不覆蓋（port 不同）
  --exclude='.env.dev'         # 同上
  --exclude='*.log'
  --exclude='data/'            # runtime data (crews, knowledge, sessions, logs)
  --exclude='backups/'         # runtime backups
  --exclude='building/'       # runtime build artifacts
  --exclude='logs/'            # runtime logs
  --exclude='.paaw/'           # runtime state (sessions, memory, intelligence)
  --exclude='dist/'           # build artifacts
  --exclude='.DS_Store'
)

# ── Status mode ──
if [[ " $* " == *" status "* ]]; then
  echo ""
  echo -e "${CYAN}═══ PAAW Sync Status ═══${NC}"
  echo ""

  if [ -d "$TPAAW/.git" ] && [ -d "$TPAAW_DEV/.git" ]; then
    TPAAW_COMMIT=$(cd "$TPAAW" && git log --oneline -1 2>/dev/null || echo "(no git)")
    TPAAW_DEV_COMMIT=$(cd "$TPAAW_DEV" && git log --oneline -1 2>/dev/null || echo "(no git)")
    echo "  tPAAW:     $TPAAW_COMMIT"
    echo "  tPAAW-dev: $TPAAW_DEV_COMMIT"
  fi

  # File diff count (rsync dry-run)
  RSYNC_OUT=$(rsync -a --delete --dry-run \
    "${SYNC_EXCLUDES[@]}" \
    --out-format='%n' "$TPAAW/" "$TPAAW_DEV/" 2>/dev/null || true)

  DIFF_COUNT=$(echo "$RSYNC_OUT" | grep -c '.' || true)
  echo "  Files different (rsync): $DIFF_COUNT"

  if [ $DIFF_COUNT -gt 0 ] && [ $DIFF_COUNT -le 20 ]; then
    echo "$RSYNC_OUT" | while read -r f; do
      [ -n "$f" ] && echo "    $f"
    done
  fi
  echo ""
  exit 0
fi

# ── Direction ──
if [ "$DIRECTION" = "dev" ]; then
  SRC="$TPAAW_DEV"
  DST="$TPAAW"
  DIRECTION_LABEL="tPAAW-dev → tPAAW"
else
  SRC="$TPAAW"
  DST="$TPAAW_DEV"
  DIRECTION_LABEL="tPAAW → tPAAW-dev"
fi

echo ""
echo -e "${CYAN}═══ PAAW Sync: ${DIRECTION_LABEL} ═══${NC}"
echo -e "  Mode: ${MODE}"
echo ""

# ══════════════════════════════════════════════════════════
#  RSYNC MODE — 直接複製，不需要 GitHub
# ══════════════════════════════════════════════════════════
if [ "$MODE" = "rsync" ]; then

  # Skip these — per-instance state, not source code
  # (uses SYNC_EXCLUDES defined above)

  info "Counting changes..."
  DRY_RUN=$(rsync -a --delete --dry-run \
    "${SYNC_EXCLUDES[@]}" \
    --out-format='%n' "$SRC/" "$DST/" 2>/dev/null || true)
  CHANGE_COUNT=$(echo "$DRY_RUN" | grep -c '.' || true)

  if [ "$CHANGE_COUNT" -eq 0 ]; then
    ok "Already in sync — no changes needed."
    echo ""
    exit 0
  fi

  info "$CHANGE_COUNT files to sync."

  # Auto-commit in destination before overwrite (safety net)
  if [ -d "$DST/.git" ]; then
    DST_DIRTY=$(cd "$DST" && git status --short | wc -l | tr -d ' ')
    if [ "$DST_DIRTY" -gt 0 ]; then
      warn "Destination has $DST_DIRTY uncommitted files — auto-committing as safety net..."
      cd "$DST"
      git add -A
      git commit -m "auto: pre-sync snapshot $(date +%Y-%m-%d-%H%M)" --allow-empty-message 2>/dev/null || true
    fi
  fi

  # Do the rsync
  info "Syncing ${DIRECTION_LABEL}..."
  rsync -a --delete "${SYNC_EXCLUDES[@]}" "$SRC/" "$DST/"

  # Auto-commit the result in destination
  if [ -d "$DST/.git" ]; then
    cd "$DST"
    git add -A
    STAGED=$(git diff --cached --stat | wc -l | tr -d ' ')
    if [ "$STAGED" -gt 0 ]; then
      git commit -m "sync: ${DIRECTION_LABEL} ($(date +%Y-%m-%d-%H%M))" --allow-empty-message 2>/dev/null || true
      ok "Destination auto-committed sync result."
    fi
  fi

  # npm install if package files changed
  if echo "$DRY_RUN" | grep -q "package.json\|package-lock.json"; then
    info "package files changed — running npm install in destination..."
    cd "$DST" && npm install --silent 2>/dev/null &
  fi

  ok "✅ rsync complete: ${DIRECTION_LABEL}"
  echo ""
  exit 0
fi

# ══════════════════════════════════════════════════════════
#  GIT MODE — 透過 GitHub 同步（需要 GitHub repo）
# ══════════════════════════════════════════════════════════
if [ "$MODE" = "git" ]; then

  # Auto-commit uncommitted changes in source
  SRC_DIRTY=$(cd "$SRC" && git status --short | wc -l | tr -d ' ')
  if [ "$SRC_DIRTY" -gt 0 ]; then
    warn "Source has $SRC_DIRTY uncommitted files — auto-committing..."
    cd "$SRC"
    git add -A
    git commit -m "auto: pre-sync snapshot $(date +%Y-%m-%d-%H%M)" --allow-empty-message 2>/dev/null || true
    ok "Source committed."
  fi

  # Push from source
  info "Pushing from source..."
  cd "$SRC"
  git push origin dev 2>/dev/null || {
    warn "Push failed. Trying force-with-lease..."
    git push --force-with-lease origin dev 2>/dev/null || true
  }

  # Pull in destination
  info "Pulling in destination..."
  cd "$DST"
  DST_DIRTY=$(git status --short | wc -l | tr -d ' ')
  if [ "$DST_DIRTY" -gt 0 ]; then
    warn "Destination has $DST_DIRTY uncommitted files — stashing..."
    git stash --include-untracked -q 2>/dev/null || true
  fi

  git fetch origin dev 2>/dev/null || true
  git reset --hard origin/dev 2>/dev/null || git pull --force origin dev 2>/dev/null || true

  if [ "$DST_DIRTY" -gt 0 ]; then
    git stash pop -q 2>/dev/null || warn "Stash pop had conflicts (check manually)"
  fi

  # npm install if needed
  if [ -f "$DST/package.json" ]; then
    info "Running npm install..."
    cd "$DST" && npm install --silent 2>/dev/null &
  fi

  ok "✅ git sync complete: ${DIRECTION_LABEL}"
  echo ""
  exit 0
fi
